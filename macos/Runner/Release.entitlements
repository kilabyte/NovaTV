<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!--
		Chromecast casting: outbound TLS to the device on :8009 needs the
		client entitlement; the built-in dart_cast MediaProxy runs a local
		HTTP server (so the Chromecast can fetch streams with our IPTV
		headers) which needs the server entitlement. Device discovery uses
		native Bonjour via the bonsoir package, so no special multicast
		entitlement is required.
	-->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
